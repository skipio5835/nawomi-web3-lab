#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"
head=$(git rev-parse --verify HEAD)
has_updates=0

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in
    ""|*[!0]*) ;;
    *) continue ;;
  esac
  has_updates=1
  commit=$(git rev-parse --verify "${local_oid}^{commit}") || exit 1
  if [ "$commit" != "$head" ]; then
    echo "[pre-push] Blocked: check out the commit being pushed and push it separately." >&2
    exit 1
  fi
done

# Deletions and no-op pushes do not upload new code.
if [ "$has_updates" = 0 ]; then
  exit 0
fi

status=$(git status --porcelain --untracked-files=normal)
if [ -n "$status" ]; then
  echo "[pre-push] Blocked: commit your changes before pushing, including new files." >&2
  echo "[pre-push] For an earlier check, run: npm run check:push" >&2
  exit 1
fi

echo "[pre-push] Running dependency, application, and contract checks."
if ! npm run check:push; then
  echo "[pre-push] Checks failed. Nothing was pushed." >&2
  exit 1
fi

# A build or another editor must not change the checked commit during the gate.
after_head=$(git rev-parse --verify HEAD)
after_status=$(git status --porcelain --untracked-files=normal)
if [ "$after_head" != "$head" ] || [ -n "$after_status" ]; then
  echo "[pre-push] Blocked: files or HEAD changed during checks. Review and retry." >&2
  exit 1
fi

echo "[pre-push] Checks passed."
